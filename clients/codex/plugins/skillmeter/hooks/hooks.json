{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/scripts/session_start.js",
            "timeout": 10,
            "statusMessage": "SkillMeter: recording session start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/scripts/user_prompt_submit.js",
            "timeout": 10,
            "statusMessage": "SkillMeter: recording prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/scripts/pre_tool_use.js",
            "timeout": 10,
            "statusMessage": "SkillMeter: recording pre tool use"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/scripts/permission_request.js",
            "timeout": 10,
            "statusMessage": "SkillMeter: recording permission request"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/scripts/post_tool_use.js",
            "timeout": 10,
            "statusMessage": "SkillMeter: recording post tool use"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/scripts/pre_compact.js",
            "timeout": 10,
            "statusMessage": "SkillMeter: recording pre compact"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/scripts/post_compact.js",
            "timeout": 10,
            "statusMessage": "SkillMeter: recording post compact"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/scripts/subagent_start.js",
            "timeout": 10,
            "statusMessage": "SkillMeter: recording subagent start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/scripts/subagent_stop.js",
            "timeout": 30,
            "statusMessage": "SkillMeter: flushing subagent events"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/scripts/stop.js",
            "timeout": 30,
            "statusMessage": "SkillMeter: flushing event batch"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/scripts/session_end.js",
            "timeout": 3,
            "statusMessage": "SkillMeter: saving capture hint"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/scripts/interrupt.js",
            "timeout": 3,
            "statusMessage": "SkillMeter: saving capture hint"
          }
        ]
      }
    ]
  }
}
