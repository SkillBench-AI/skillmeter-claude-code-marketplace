      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hook.js UserPromptSubmit",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "signin|skillmeter:signin",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/user_prompt_expansion_signin.js",
            "timeout": 12
          }
        ]
      }
    ],
