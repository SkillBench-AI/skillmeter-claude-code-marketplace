{
  "version": "1",
  "description": "Stage-1 PII fixture corpus for policy 3.0.0 (ADR 002, decision 3). Each fixture is a string fed to redactString and the exact output expected. `kinds` lists the placeholder categories that must be reported; an empty list is a negative fixture (nothing may be redacted). `note` explains the case; `accepted_fp: true` marks a documented false positive that is redacted on purpose. Plugin-local for now; to be promoted to the shared cross-surface corpus once the Codex plugin and the session collector adopt 3.0.0.",
  "fixtures": [
    { "id": "email-ascii", "text": "ping jose@example.com", "expect": "ping [EMAIL]", "kinds": ["email"] },
    { "id": "email-unicode-local", "text": "ping josé@example.com now", "expect": "ping [EMAIL] now", "kinds": ["email"], "note": "GitHub issue #102: accented local part previously survived whole" },
    { "id": "email-unicode-name-prefix", "text": "renée.dubois@example.org sent it", "expect": "[EMAIL] sent it", "kinds": ["email"], "note": "GitHub issue #102: previously became rené[EMAIL], leaking the given name" },
    { "id": "email-cjk-local", "text": "用户@example.com", "expect": "[EMAIL]", "kinds": ["email"] },
    { "id": "email-plus-subdomain-trailing-dot", "text": "contact: dev-team+ops@sub.example.co.uk.", "expect": "contact: [EMAIL].", "kinds": ["email"] },
    { "id": "not-email-no-tld", "text": "not an email: foo@bar", "expect": "not an email: foo@bar", "kinds": [] },

    { "id": "placeholder-embedded-secret", "text": "API_KEY=[REDACTED_SECRET]", "expect": "API_KEY=[REDACTED_SECRET]", "kinds": [], "note": "GitHub issue #103: a second pass must not re-redact or count its own placeholder" },
    { "id": "placeholder-alone", "text": "[EMAIL]", "expect": "[EMAIL]", "kinds": [] },
    { "id": "placeholder-author-line", "text": "Author: [PERSON] <[EMAIL]>", "expect": "Author: [PERSON] <[EMAIL]>", "kinds": [] },
    { "id": "placeholder-stage2-vocabulary", "text": "met [PERSON] at [ADDRESS] for [CUSTOMER] of [ORG]", "expect": "met [PERSON] at [ADDRESS] for [CUSTOMER] of [ORG]", "kinds": [] },

    { "id": "vcs-author", "text": "Author: Jane Doe <jane@example.com>\nDate: Mon Sep 1", "expect": "Author: [PERSON] <[EMAIL]>\nDate: Mon Sep 1", "kinds": ["person", "email"] },
    { "id": "vcs-co-authored-by", "text": "Co-authored-by: Kim Min-jun <minjun@example.kr>", "expect": "Co-authored-by: [PERSON] <[EMAIL]>", "kinds": ["person", "email"] },
    { "id": "vcs-signed-off-by", "text": "Signed-off-by: Bob <bob@x.io>", "expect": "Signed-off-by: [PERSON] <[EMAIL]>", "kinds": ["person", "email"] },
    { "id": "vcs-author-no-name", "text": "Author: <bot@x.io>", "expect": "Author: <[EMAIL]>", "kinds": ["email"], "note": "no name before the address, nothing to replace with [PERSON]" },
    { "id": "author-in-prose", "text": "the author: someone wrote this", "expect": "the author: someone wrote this", "kinds": [], "note": "no angle bracket, so not VCS metadata" },

    { "id": "phone-kr-mobile", "text": "call 010-1234-5678 today", "expect": "call [PHONE] today", "kinds": ["phone"] },
    { "id": "phone-kr-international", "text": "+82 10 1234 5678", "expect": "[PHONE]", "kinds": ["phone"] },
    { "id": "phone-us-international", "text": "+1 415 555 2671", "expect": "[PHONE]", "kinds": ["phone"] },
    { "id": "phone-us-parenthesised", "text": "(415) 555-2671", "expect": "[PHONE]", "kinds": ["phone"] },
    { "id": "phone-kr-landline", "text": "02-123-4567", "expect": "[PHONE]", "kinds": ["phone"] },
    { "id": "phone-too-short", "text": "tel 555-2671", "expect": "tel 555-2671", "kinds": [] },
    { "id": "not-phone-iso-datetime", "text": "at 2026-09-11 01:16:33Z", "expect": "at 2026-09-11 01:16:33Z", "kinds": [], "note": "date grammar would otherwise read 2026-09-11 01 as ten digits" },
    { "id": "not-phone-isbn", "text": "ISBN 978-3-16-148410-0", "expect": "ISBN 978-3-16-148410-0", "kinds": [] },
    { "id": "not-phone-ms-timestamp", "text": "ts 1789058042316", "expect": "ts 1789058042316", "kinds": [], "note": "bare digit run" },
    { "id": "not-phone-time", "text": "time 01:16:33", "expect": "time 01:16:33", "kinds": [] },
    { "id": "not-phone-id-then-date", "text": "row 44 2026-09-05 ok", "expect": "row 44 2026-09-05 ok", "kinds": [], "note": "observed on real transcripts: an id followed by an ISO date" },
    { "id": "not-phone-dotted-network-fragment", "text": "link-local 169.254.100 range", "expect": "link-local 169.254.100 range", "kinds": [], "note": "observed on real transcripts: three dotted groups" },
    { "id": "phone-fr-dotted", "text": "tel 01.23.45.67.89", "expect": "tel [PHONE]", "kinds": ["phone"] },
    { "id": "phone-spaced-numeric-id-accepted", "text": "1 234 567 890 units", "expect": "1 [PHONE] units", "kinds": ["phone"], "accepted_fp": true, "note": "separator-formatted numeric id of 9+ digits, accepted per ADR 002" },
    { "id": "phone-invalid-ssn-shape-accepted", "text": "bad ssn 000-12-3456", "expect": "bad ssn [PHONE]", "kinds": ["phone"], "accepted_fp": true, "note": "never-issued SSN area falls through to the phone rule; still redacted" },

    { "id": "ipv4-private", "text": "host 10.0.0.1 down", "expect": "host [IP] down", "kinds": ["ip"] },
    { "id": "ipv4-with-port", "text": "server 192.168.1.20:8080", "expect": "server [IP]:8080", "kinds": ["ip"] },
    { "id": "ipv4-public", "text": "8.8.8.8", "expect": "[IP]", "kinds": ["ip"] },
    { "id": "ipv4-cidr", "text": "cidr 172.16.0.0/12", "expect": "cidr [IP]/12", "kinds": ["ip"] },
    { "id": "ipv4-loopback-kept", "text": "loop 127.0.0.1", "expect": "loop 127.0.0.1", "kinds": [] },
    { "id": "ipv4-unspecified-kept", "text": "any 0.0.0.0", "expect": "any 0.0.0.0", "kinds": [] },
    { "id": "ipv4-documentation-kept", "text": "doc 192.0.2.44 and 203.0.113.9", "expect": "doc 192.0.2.44 and 203.0.113.9", "kinds": [] },
    { "id": "version-with-v-prefix-kept", "text": "v1.2.3.4 released", "expect": "v1.2.3.4 released", "kinds": [] },
    { "id": "version-five-parts-kept", "text": "version 1.2.3.4.5", "expect": "version 1.2.3.4.5", "kinds": [] },
    { "id": "version-four-parts-accepted", "text": "version 1.2.3.4", "expect": "version [IP]", "kinds": ["ip"], "accepted_fp": true, "note": "indistinguishable from an address, accepted per ADR 002" },

    { "id": "ipv6-full", "text": "fd12:3456:789a:0001:0000:0000:0000:0001", "expect": "[IP]", "kinds": ["ip"] },
    { "id": "ipv6-compressed", "text": "2607:f8b0:4005:80a::200e", "expect": "[IP]", "kinds": ["ip"] },
    { "id": "ipv6-link-local-with-zone", "text": "fe80::1%en0", "expect": "[IP]%en0", "kinds": ["ip"] },
    { "id": "ipv6-bracketed-with-port", "text": "[2001:4860:4860::8888]:443", "expect": "[[IP]]:443", "kinds": ["ip"] },
    { "id": "ipv6-documentation-kept", "text": "2001:db8::1", "expect": "2001:db8::1", "kinds": [] },
    { "id": "ipv6-loopback-kept", "text": "::1 loop", "expect": "::1 loop", "kinds": [] },
    { "id": "not-ipv6-cpp-namespace", "text": "std::vector<int>", "expect": "std::vector<int>", "kinds": [] },
    { "id": "not-ipv6-hex-namespace", "text": "use fe::add; let x = a::b;", "expect": "use fe::add; let x = a::b;", "kinds": [], "note": "all-hex identifiers around :: are source code, not addresses" },
    { "id": "not-ipv6-mac-address", "text": "mac aa:bb:cc:dd:ee:ff", "expect": "mac aa:bb:cc:dd:ee:ff", "kinds": [] },

    { "id": "id-kr-rrn", "text": "rrn 900101-1234567", "expect": "rrn [ID_NUMBER]", "kinds": ["id_number"] },
    { "id": "id-kr-rrn-bad-month-kept", "text": "bad 901301-1234567", "expect": "bad 901301-1234567", "kinds": [] },
    { "id": "id-kr-rrn-undashed-kept", "text": "13 digits 9001011234567", "expect": "13 digits 9001011234567", "kinds": [], "note": "contiguous form is too close to millisecond timestamps" },
    { "id": "id-us-ssn", "text": "ssn 123-45-6789", "expect": "ssn [ID_NUMBER]", "kinds": ["id_number"] },

    { "id": "card-visa-spaces", "text": "visa 4111 1111 1111 1111", "expect": "visa [CARD]", "kinds": ["card"] },
    { "id": "card-visa-dashes", "text": "visa 4111-1111-1111-1111", "expect": "visa [CARD]", "kinds": ["card"] },
    { "id": "card-amex", "text": "amex 378282246310005", "expect": "amex [CARD]", "kinds": ["card"] },
    { "id": "card-mastercard", "text": "mc 5555555555554444", "expect": "mc [CARD]", "kinds": ["card"] },
    { "id": "card-amex-grouped", "text": "amex 3782 822463 10005", "expect": "amex [CARD]", "kinds": ["card"] },
    { "id": "card-luhn-fail-kept", "text": "invoice 4000-0000-0000-0001", "expect": "invoice 4000-0000-0000-0001", "kinds": [] },
    { "id": "card-unknown-issuer-kept", "text": "random 1234567812345678", "expect": "random 1234567812345678", "kinds": [] },
    { "id": "card-irregular-grouping-kept", "text": "ids 2-4860-8414-7239 and 22350729-2259-4 and 257-1824-4074-8138-9", "expect": "ids 2-4860-8414-7239 and 22350729-2259-4 and 257-1824-4074-8138-9", "kinds": [], "note": "observed on real transcripts: Luhn-valid by coincidence, but not card grouping" },
    { "id": "card-mixed-separators-kept", "text": "seq 46963 68924 06-09", "expect": "seq 46963 68924 06-09", "kinds": [] },
    { "id": "card-visa-wrong-length-kept", "text": "n 44061085000000005", "expect": "n 44061085000000005", "kinds": [], "note": "17 digits: Visa issues 13, 16 or 19" },
    { "id": "vcs-author-overlong-name-kept", "text": "Author: this is not a name but a very long sentence that keeps going and going and going past eighty characters <x@y.zz>", "expect": "Author: this is not a name but a very long sentence that keeps going and going and going past eighty characters <[EMAIL]>", "kinds": ["email"], "note": "a name longer than 80 characters is not a name; the address is still redacted" },

    { "id": "mixed-line", "text": "mail a@b.co card 4111 1111 1111 1111 from 10.1.2.3", "expect": "mail [EMAIL] card [CARD] from [IP]", "kinds": ["email", "card", "ip"] }
  ]
}
