#!/usr/bin/env node
/**
 * skillmeter-force-refresh — clear the stored license JWT and run the
 * activation flow immediately. Useful for:
 *   - swapping tenants (pull a fresh JWT with new telemetry_endpoint)
 *   - recovering from a revoked/rotated license without waiting for
 *     the natural 15-minute expiry
 *   - testing activate.js's silent-gh path
 *
 * The gh silent-failure cooldown is reset before the flow starts so a
 * rate-limit from an earlier run doesn't block a fresh attempt.
 *
 * Usage:
 *   skillmeter-force-refresh
 */
const path = require("path");

const PLUGIN_ROOT = process.env.CLAUDE_PLUGIN_ROOT || path.resolve(__dirname, "..");
process.env.CLAUDE_PLUGIN_ROOT = PLUGIN_ROOT;

const credstore = require(path.join(PLUGIN_ROOT, "scripts", "credstore.js"));

const existing = credstore.getLicenseToken();
if (existing) {
  process.stderr.write("skillmeter-force-refresh: clearing stored license JWT\n");
  credstore.setLicenseToken("");
} else {
  process.stderr.write("skillmeter-force-refresh: no stored license; running fresh activation\n");
}

// Reset the gh silent-failure cooldown so the silent path is attempted
// again immediately. Matches the behavior of /activate itself.
credstore.setGhFallbackRetryAfter(0);

const activate = require(path.join(PLUGIN_ROOT, "scripts", "activate.js"));
activate.main().catch((err) => {
  process.stderr.write(`Activation failed: ${err.message}\n`);
  process.exit(1);
});
